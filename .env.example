# ==============================================================================
# Multi-Agent AI Interview Platform Environment Configuration
# ==============================================================================

# --- Database Setup ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/interview_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_db

# --- Cache Setup ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI LLM Provider Configuration ---
# Gemini API Key (Default recommended model provider)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative LLM Provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector Storage / RAG (if needed) ---
# Embeddings configuration
EMBEDDING_API_KEY=

# --- S3 Compatible Storage ---
S3_BUCKET=interview-platform-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT_URL= # Set for MinIO or localstack

# --- LangSmith Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-platform
LANGSMITH_TRACING=false

# --- Frontend specific configs ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
